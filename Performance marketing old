<style>
@import url('https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Inter:wght@400;500;600&display=swap');

#loki-page{
  margin:0;
  --ink:#141417;
  --ink-soft:#4a4a52;
  --paper:#faf8f4;
  --card:#ffffff;
  --line:#e7e3da;
  --accent:#c85a2e;
  --accent-ink:#ffffff;
  --teal:#1f4d45;
  --chip:#f1ece1;
  --radius:14px;
  --maxw:1120px;
  background:var(--paper);
  color:var(--ink);
  font-family:'Inter',system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
  line-height:1.55;
  -webkit-font-smoothing:antialiased;
  scroll-behavior:smooth;
}
#loki-page *{box-sizing:border-box;}
#loki-page h1,#loki-page h2,#loki-page h3,#loki-page h4{
  font-family:'Sora',system-ui,sans-serif;
  color:var(--ink);
  margin:0 0 0.5em;
  letter-spacing:-0.01em;
}
#loki-page p{margin:0 0 1em;}
#loki-page a{color:inherit;}
#loki-page .wrap{max-width:var(--maxw); margin:0 auto; padding:0 24px;}
#loki-page .badge{
  display:inline-block; font-size:12px; font-weight:600; letter-spacing:0.06em;
  text-transform:uppercase; color:var(--accent); background:#fbe9df;
  padding:6px 12px; border-radius:999px; margin-bottom:16px;
}

/* NAV */
#loki-page nav{
  position:sticky; top:0; z-index:20; background:rgba(250,248,244,0.92);
  backdrop-filter:blur(6px); border-bottom:1px solid var(--line);
}
#loki-page nav .wrap{display:flex; align-items:center; justify-content:space-between; padding-block:16px;}
#loki-page .logo{font-family:'Sora',sans-serif; font-weight:800; font-size:20px; letter-spacing:-0.02em; text-decoration:none; color:var(--ink);}
#loki-page .logo span{color:var(--accent);}
#loki-page .navlinks{display:flex; gap:28px; font-size:14px; font-weight:500; list-style:none; margin:0; padding:0;}
#loki-page .navlinks a{text-decoration:none; opacity:0.75;}
#loki-page .navlinks a:hover{opacity:1;}
#loki-page .navlinks a.active{opacity:1; color:var(--accent);}
#loki-page .region-switch{font-size:13px; font-weight:600; border:1px solid var(--line); border-radius:999px; padding:4px 10px; display:flex; gap:6px;}
#loki-page .region-switch .on{color:var(--accent);}
#loki-page .navcta{
  background:var(--ink); color:#fff; font-size:14px; font-weight:600;
  padding:10px 18px; border-radius:999px; text-decoration:none;
}

/* HERO */
#loki-page header.hero{padding:72px 0 56px; border-bottom:1px solid var(--line);}
#loki-page .hero-grid{display:grid; grid-template-columns:1.15fr 0.85fr; gap:48px; align-items:center;}
#loki-page .hero h1{font-size:clamp(32px,4.5vw,50px); line-height:1.1;}
#loki-page .hero .sub p{font-size:16.5px; color:var(--ink-soft); max-width:56ch; line-height:1.65;}
#loki-page .hero .sub strong{color:var(--ink); font-weight:700;}
#loki-page .cta-row{display:flex; gap:14px; margin-top:20px; flex-wrap:wrap;}
#loki-page .btn{
  display:inline-flex; align-items:center; gap:8px; text-decoration:none;
  font-weight:600; font-size:15px; padding:13px 24px; border-radius:999px;
  transition:transform .15s ease; border:none; cursor:pointer;
}
#loki-page .btn:hover{transform:translateY(-1px);}
#loki-page .btn-primary{background:var(--accent); color:var(--accent-ink);}
#loki-page .btn-secondary{background:transparent; color:var(--ink); border:1.5px solid var(--ink);}
#loki-page .hero-visual{
  aspect-ratio:4/3;
  border-radius:var(--radius);
  background:url('https://blog.thisisloki.com/wp-content/uploads/2026/09/loki_namecards-copy-e1789443894867.jpg') center/cover no-repeat;
  position:relative;
  overflow:hidden;
}

#loki-page .hero-visual::before{display:none;}

#loki-page .hero-visual .tag{display:none;}

/* TRUST BAR */
#loki-page .trust{padding:28px 0; border-bottom:1px solid var(--line); background:var(--card);}
#loki-page .trust ul{
  list-style:none; margin:0; padding:0; display:grid;
  grid-template-columns:repeat(4,1fr); gap:24px;
}
#loki-page .trust li{font-size:13.5px; color:var(--ink-soft); font-weight:500;}
#loki-page .trust strong{display:block; font-family:'Sora',sans-serif; font-size:20px; color:var(--ink); font-weight:700; margin-bottom:2px;}

/* SECTION SHARED */
#loki-page section{padding:64px 0;}
#loki-page .section-head{max-width:66ch; margin-bottom:40px;}
#loki-page .section-head h2{font-size:clamp(26px,3vw,34px);}
#loki-page .section-head p{color:var(--ink-soft); font-size:16px;}

/* INTRO (service page positioning intro) */
#loki-page .intro-lead{font-size:18px; color:var(--ink-soft); max-width:760px; line-height:1.65; margin-bottom:32px;}
#loki-page .partner-copy{max-width:760px;}
#loki-page .partner-copy p{font-size:15.5px; color:var(--ink-soft); line-height:1.65;}

/* CAPABILITIES BOX (numbered service capability card on single-service pages) */
#loki-page .cap-box{
  max-width:640px; background:var(--card); border:1px solid var(--line);
  border-radius:var(--radius); padding:28px 28px 24px; margin-top:32px;
}
#loki-page .cap-kicker{font-family:'Sora',sans-serif; font-weight:700; font-size:13px; color:var(--accent); margin-bottom:6px;}
#loki-page .cap-box h3{font-size:19px; margin-bottom:16px;}
#loki-page .cap-box ul{list-style:none; margin:0; padding:0;}
#loki-page .cap-box li{font-size:14.5px; color:var(--ink-soft); padding:7px 0 7px 18px; position:relative; border-top:1px solid var(--line);}
#loki-page .cap-box li:first-child{border-top:none;}
#loki-page .cap-box li::before{content:"•"; color:var(--accent); position:absolute; left:0;}
#loki-page .cap-box .linkline{display:inline-block; margin-top:18px; font-size:13.5px; font-weight:600; color:var(--accent); text-decoration:none;}

/* CASE STUDY / WORK SHOWCASE GRID */
#loki-page .case-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:20px;}
#loki-page .case-card{
  aspect-ratio:4/3; border-radius:var(--radius); background:linear-gradient(135deg,var(--teal),#0f2f2a);
  position:relative; overflow:hidden; padding:18px; display:flex; flex-direction:column; justify-content:flex-end;
  color:#fff;
}
#loki-page .case-card::before{
  content:""; position:absolute; inset:0;
  background:radial-gradient(circle at 25% 20%, rgba(255,255,255,0.12), transparent 40%);
}
#loki-page .case-card .case-n{position:relative; font-family:'Sora',sans-serif; font-weight:700; font-size:13px; opacity:0.7; margin-bottom:8px;}
#loki-page .case-card .case-label{position:relative; font-size:13px; font-weight:600; opacity:0.85;}

/* EXPLORE OTHER SERVICES */
#loki-page .explore-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:20px;}
#loki-page .explore-card{
  display:block; text-decoration:none; color:inherit; background:var(--card);
  border:1px solid var(--line); border-radius:var(--radius); padding:20px;
  transition:border-color .15s ease;
}
#loki-page .explore-card:hover{border-color:var(--accent);}
#loki-page .explore-card .n{
  width:26px; height:26px; border-radius:50%; background:var(--chip); color:var(--accent);
  display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:700;
  font-family:'Sora',sans-serif; margin-bottom:12px;
}
#loki-page .explore-card h4{font-size:15.5px; margin-bottom:6px;}
#loki-page .explore-card p{font-size:13.5px; color:var(--ink-soft); margin:0; line-height:1.5;}

/* FAQ */
#loki-page details{border-bottom:1px solid var(--line); padding:18px 0;}
#loki-page details summary{
  cursor:pointer; font-weight:600; font-size:16px; list-style:none;
  display:flex; justify-content:space-between; align-items:center; gap:16px;
}
#loki-page details summary::-webkit-details-marker{display:none;}
#loki-page details summary::after{content:"+"; font-size:20px; color:var(--accent); flex:none;}
#loki-page details[open] summary::after{content:"−";}
#loki-page details p{margin-top:12px; font-size:14.5px; color:var(--ink-soft); max-width:70ch; line-height:1.6;}
#loki-page details p.flag{color:var(--accent); font-style:italic;}

/* CLOSING CTA */
#loki-page .closing{
  background:var(--ink); color:#fff; border-radius:20px; padding:56px 40px;
  text-align:center; margin:0 24px 80px; max-width:calc(var(--maxw) - 48px); margin-inline:auto;
}
#loki-page .closing h2{color:#fff; font-size:clamp(26px,3.4vw,36px); max-width:28ch; margin-inline:auto;}
#loki-page .closing p{color:#cfcdc8; max-width:56ch; margin-inline:auto;}
#loki-page .closing .btn-primary{margin-top:8px;}

#loki-page footer{padding:32px 0 60px; font-size:13px; color:var(--ink-soft); text-align:center;}

@media (max-width:860px){
  #loki-page .navlinks{display:none;}
  #loki-page .hero-grid{grid-template-columns:1fr;}
  #loki-page .hero-visual{aspect-ratio:16/9;}
  #loki-page .trust ul{grid-template-columns:repeat(2,1fr);}
  #loki-page .case-grid{grid-template-columns:1fr 1fr;}
  #loki-page .explore-grid{grid-template-columns:1fr 1fr;}
  #loki-page .closing{padding:40px 24px;}
}
@media (max-width:560px){
  #loki-page .case-grid{grid-template-columns:1fr;}
  #loki-page .explore-grid{grid-template-columns:1fr;}
}
</style>

