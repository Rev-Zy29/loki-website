/* Integrated grid, service pills, ticker, and scroll motion. */
#loki-page{--ink:#f5f5f5;--muted:#b0b0b0;--accent:#fb6a46;--line:#333;--paper:#14141f}
#loki-page .hero{position:relative;background-image:linear-gradient(90deg,#ffffff0b 1px,transparent 1px),linear-gradient(#ffffff0b 1px,transparent 1px);background-size:calc(90% / 6) 64px;background-position:5% 0}
#loki-page .hero:before{content:'';position:absolute;inset:0;pointer-events:none;background:linear-gradient(transparent 35%,#14141f)}
#loki-page .hero-grid{position:relative;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr)}
#loki-page .hero h1>span:not(.hero-kicker){animation:loki-rise .85s cubic-bezier(.2,.8,.2,1) both}
#loki-page .hero h1>span:nth-child(3){animation-delay:.12s}
#loki-page .hero h1>span:nth-child(4){animation-delay:.24s}
#loki-page .marquee-band{background:var(--accent);color:#14141f;overflow:hidden;padding:12px 0 20px;border-block:1px solid #14141f}
#loki-page .marquee-toolbar{width:90%;margin:0 auto 10px;text-align:right}
#loki-page .ticker-toggle{font:600 13px Manrope,Arial,sans-serif;border:1px solid #14141f66;border-radius:30px;padding:4px 12px;color:#14141f;background:transparent}
#loki-page .marquee-track{display:flex;width:max-content;animation:loki-ticker 38s linear infinite}
#loki-page .marquee-group{display:flex;flex-shrink:0}
#loki-page .marquee-group span{font-size:16px;font-weight:700;letter-spacing:.025em;text-transform:uppercase;padding-inline:28px;white-space:nowrap;display:flex;align-items:center;gap:28px}
#loki-page .marquee-group span:after{content:'✳';font-size:14px;opacity:.55}

#loki-page .service>summary{grid-template-columns:60px minmax(0,1fr) auto 38px}
#loki-page .service>summary h3{font-size:clamp(25px,3vw,40px);transition:color .25s,letter-spacing .25s}
#loki-page .service>summary:hover h3{letter-spacing:-.025em}
#loki-page .service-tag{font-size:13px;text-transform:uppercase;letter-spacing:.08em;color:#aaa}
#loki-page .service>summary:after{border:1px solid #ffffff55;border-radius:50%;width:36px;height:36px;font-size:25px;line-height:32px}
#loki-page .service[open]>summary:after{background:var(--accent);color:#14141f;border-color:var(--accent)}
#loki-page .service-copy{padding:0 0 34px 78px;animation:loki-rise .35s ease}
#loki-page .service-copy>p{color:var(--muted);max-width:65ch;font-size:17px;margin-bottom:22px}
#loki-page .offerings{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:24px}
#loki-page .offerings span{font-family:Manrope,Arial,sans-serif;font-size:14px;line-height:1.5;padding:7px 14px;border:1px solid #ffffff29;border-radius:999px;color:#bcbcbc;transition:border-color .25s,color .25s,background .25s}
#loki-page .offerings span:hover{border-color:var(--accent);color:#fff;background:#fb6a460c}
#loki-page .faq>.wrap{grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr)}
#loki-page .faq details[open] summary{color:var(--accent)}
#loki-page .merge-reveal{opacity:1;transform:none;transition:opacity .7s cubic-bezier(.2,.8,.2,1),transform .7s cubic-bezier(.2,.8,.2,1)}
#loki-page .merge-reveal.pre{opacity:0;transform:translateY(28px)}
@keyframes loki-ticker{to{transform:translateX(-50%)}}
@keyframes loki-rise{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:none}}
@media(max-width:800px){#loki-page .hero-grid,#loki-page .faq>.wrap{grid-template-columns:1fr}#loki-page .service>summary{grid-template-columns:28px minmax(0,1fr) 36px}#loki-page .service-tag{display:none}#loki-page .service-copy{padding-left:0}#loki-page .hero h1{font-size:clamp(48px,11.5vw,95px)}#loki-page .offerings span{font-size:14px}#loki-page .marquee-group span{font-size:14px;padding-inline:18px}}
@media(prefers-reduced-motion:reduce){#loki-page .marquee-track{animation:none;width:auto}#loki-page .marquee-group{flex-wrap:wrap;gap:12px;justify-content:center}#loki-page .marquee-group[aria-hidden]{display:none}#loki-page .marquee-toolbar{display:none}#loki-page .merge-reveal.pre{opacity:1;transform:none}#loki-page .hero h1>span,#loki-page .service-copy{animation:none}}


